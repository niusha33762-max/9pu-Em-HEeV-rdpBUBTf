# ---------- الزامی ----------
BOT_TOKEN=123456:ABC...
CHANNEL_ID=@your_channel
ADMIN_ID=123456789

# ---------- rsshub ----------
# آدرس instance شخصی (بدون / آخر). روی اون instance باید TWITTER_AUTH_TOKEN تنظیم شده باشه
RSSHUB_URL=https://my-rsshub.onrender.com
# همون ACCESS_KEY که روی instance خودت گذاشتی (اختیاری)
RSSHUB_KEY=
# با داشتن RSSHUB_URL پیش‌فرض 0 است (فقط instance شخصی)
USE_PUBLIC_INSTANCES=0
# route توییتر ({username} جایگزین می‌شه)
FEED_ROUTE=/twitter/user/{username}
REQUEST_TIMEOUT=60

# ---------- گیت‌هاب (ذخیره‌ی دائمی منابع و فیلترها) ----------
GITHUB_TOKEN=
GITHUB_REPO=user/repo
# پیشنهاد: یه branch جدا برای داده، تا commitها باعث redeploy نشن
GITHUB_BRANCH=data

# ---------- اختیاری ----------
CHANNEL_SIGNATURE=@XNewsCafe
CHECK_INTERVAL=900
# فاصله بین درخواست به منبع‌ها (ثانیه) و مدت توقف (دقیقه) بعد از خطای 429 روی rsshub
SOURCE_DELAY=3
FEED_BACKOFF_MINUTES=10
MAX_PER_RUN=5
# رد کردن ریپلای و ریتوییت (1 = رد بشن)
SKIP_REPLIES=1
SKIP_RETWEETS=1
# حذف هشتگ‌ها از متن (1 = حذف بشن)
STRIP_HASHTAGS=0
SEND_IMAGE=1
SEND_VIDEO=1
MAX_VIDEO_MB=50
# کپشن بلند: preview (پیش‌نمایش عکس بالای متن) یا photo_first (اول عکس، بعد متن)
LONG_CAPTION_MODE=preview
# توییت‌هایی که فقط عکس/ویدیو دارن و متن ندارن (1 = ارسال بشن)
POST_WITHOUT_CAPTION=0
# اگه ترجمه شکست خورد (1 = متن اصلی ارسال بشه، 0 = رد بشه و بعداً دوباره تلاش بشه)
POST_UNTRANSLATED=0
MIN_CAPTION_LEN=5

# ---------- ترجمه ----------
# ترجمه‌ی رایگان گوگل روی Render معمولاً خطای 429 می‌ده (IP بلاک می‌شه).
# هر کدوم از کلیدهای زیر رو بذاری، اون مترجم اول امتحان می‌شه (ترتیب پیش‌فرض: claude, azure, gcloud, deep, gtx)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
GOOGLE_TRANSLATE_API_KEY=
# ترتیب دلخواه (اختیاری): claude,azure,gcloud,cloudflare_llm,cloudflare,openai_compat,deep,gtx,lingva,mymemory
# Cloudflare Workers AI: ترجمه‌ی رایگان و بدون کارت، مستقل از بلاک IP گوگل (راهنما در README)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# مدل ترجمه روی Workers AI (پیش‌فرض Gemma 3). بعد از تغییر، با «تست مترجم» کیفیت رو چک کن
# اگه خالی بذاری، چند مدل به ترتیب امتحان می‌شه و مدلی که حساب بهش دسترسی نداره کنار گذاشته می‌شه
CLOUDFLARE_LLM_MODEL=
# (اختیاری) فهرست کامل مدل‌ها به ترتیب اولویت
CLOUDFLARE_LLM_MODELS=@cf/google/gemma-4-26b-a4b-it,@cf/mistralai/mistral-small-3.1-24b-instruct,@cf/meta/llama-3.3-70b-instruct-fp8-fast
TRANSLATE_PROVIDERS=
# بعد از خطای 429، مترجم چند دقیقه کنار گذاشته بشه
TRANSLATE_BLOCK_MINUTES=30
# instanceهای Lingva (برای مترجم lingva؛ با کاما جدا)
LINGVA_INSTANCES=https://lingva.ml,https://translate.plausibility.cloud,https://lingva.garudalinux.org,https://translate.projectsegfau.lt
# ایمیل برای MyMemory (سقف روزانه ۵۰۰۰ به ۵۰۰۰۰ کاراکتر می‌رسه؛ نیازی به ثبت‌نام نیست)
MYMEMORY_EMAIL=
# پروکسی برای مترجم‌های رایگان (با کاما جدا). مثال: http://user:pass@host:port
# با پروکسی چرخشی (rotating)، هر درخواست از IP جدید می‌ره و بلاک گوگل دور زده می‌شه
TRANSLATE_PROXIES=
TRANSLATE_PROXY_TRIES=3
# جایگزینی کلمه روی خروجی ترجمه (کلمه=جایگزین، با کاما جدا). «عاجل=فوری» همیشه فعاله
TRANSLATE_GLOSSARY=
# مترجم سازگار با OpenAI (Groq, Cerebras, OpenRouter, Mistral و...): هر سه مقدار لازمه. اسم مدل را از مستندات همان سرویس بردار.
# برای سرویس دوم و سوم پسوند 2 و 3 بگذار (OPENAI_COMPAT2_BASE_URL و ...)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
# حداقل فاصله (ثانیه) بین دو درخواست ترجمه به یک مترجم
TRANSLATE_MIN_GAP=0.7
